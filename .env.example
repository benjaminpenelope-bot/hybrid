# ── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Cle service : serveur uniquement, jamais exposee au client.
SUPABASE_SERVICE_ROLE_KEY=

# ── Coach ───────────────────────────────────────────────────
# Serveur uniquement. Sans cette cle, le coach bascule sur ses reponses locales.
# A creer sur https://console.anthropic.com — puis la reporter aussi dans les
# variables d'environnement Vercel, sinon seul le local aura le coach en ligne.
ANTHROPIC_API_KEY=

# Plafonds du coach en ligne. Facultatifs : les valeurs par defaut sont dans
# lib/coach/quota.ts. Reglables sans redeploiement une fois qu'on aura des
# mesures reelles dans la table coach_usage.
# COACH_LIMITE_FREE_JOUR=3
# COACH_LIMITE_FREE_MOIS=20
# COACH_LIMITE_PRO_JOUR=15
# COACH_LIMITE_PRO_MOIS=60

# ── Strava ──────────────────────────────────────────────────
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Jeton verifie par Strava a la creation de l'abonnement webhook.
STRAVA_VERIFY_TOKEN=
# Cle AES-256 (32 octets en base64) servant a chiffrer les tokens en base.
# Generer avec : openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ── Paiement (Stripe) ───────────────────────────────────────
# Facultatif : sans ces trois variables, l'app tourne exactement comme avant.
# L'essai gratuit de 14 jours fonctionne meme sans Stripe, et la page /pro
# annonce alors que le paiement n'est pas ouvert plutot que d'afficher un
# bouton mort.
#
# 1. Cle secrete : https://dashboard.stripe.com/apikeys  (sk_live_... ou sk_test_...)
STRIPE_SECRET_KEY=
# 2. Identifiants des deux tarifs recurrents (price_..., pas prod_...)
STRIPE_PRIX_MENSUEL=
STRIPE_PRIX_ANNUEL=
# 3. Secret de signature du webhook (whsec_...). Sans lui la route refuse tout :
#    une requete non signee permettrait de s'offrir l'abonnement.
STRIPE_WEBHOOK_SECRET=

# ── Application ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3400
